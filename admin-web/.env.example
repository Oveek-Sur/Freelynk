# ---------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key. SERVER-ONLY. Never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# Admin panel login (only you)
# ---------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-long

# Signs the admin session cookie. Generate:  openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------
# Payload encryption shared with the mobile app.
# The SAME value must go into mobile/lib/core/app_config.dart
# Generate:  openssl rand -hex 32
# ---------------------------------------------------------------
SYNC_SECRET=

# Extra gate so random people can't hit /api/sync. Any long random string.
SYNC_CLIENT_KEY=
